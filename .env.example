# Next.js environment variables template
# Copy to .env.local and fill in real values

# Supabase (Stage 5 Part A defines the schema only; the app is not connected yet)
# Public values may be used by a future browser client. They are inlined at build time.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Prefer the current Supabase publishable key. The app also accepts the legacy
# NEXT_PUBLIC_SUPABASE_ANON_KEY during a key migration, but never exposes a service key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-key>
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<legacy-anon-key>
# Exact public application origin used for Supabase Auth redirects. This must
# match the Supabase Auth Site URL / Redirect URL allowlist for each deployment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-only values. Never prefix these with NEXT_PUBLIC_ and never import them in client components.
SUPABASE_SERVICE_ROLE_KEY=<server-only-service-role-key>
# For CLI/migration tooling only; do not expose this value to the browser.
SUPABASE_DB_URL=<postgres-connection-string>
# Server-only random secret (32+ characters) used to bind a recovery callback
# to the verified Supabase session before a password can be changed.
SUPABASE_RECOVERY_COOKIE_SECRET=<generate-a-random-32-plus-character-secret>

# Storefront CMS source. Keep `local` until an owner has completed an approved
# import, reconciliation, private-media validation, and a separate cutover.
# Allowed values: local | supabase
KDEALS_STOREFRONT_DATA_SOURCE=local

# Staging-only owner import gate. Leave unset in local development and every
# production environment. It only becomes active when the configured Supabase
# URL is the approved K DEALS staging project.
# KDEALS_IMPORT_EXECUTION=staging

# WhatsApp checkout (admin-managed; placeholder until real Kuwait number is provided)
NEXT_PUBLIC_WHATSAPP_NUMBER=+965 65843535

# Store currency
NEXT_PUBLIC_STORE_CURRENCY=KWD

# Store name (both languages, admin-managed)
NEXT_PUBLIC_STORE_NAME_EN=K DEALS
NEXT_PUBLIC_STORE_NAME_AR=ك ديلز

# Public product image bucket (Stage 5)
NEXT_PUBLIC_PRODUCT_IMAGES_BUCKET=product-images

# Google analytics (optional)
# NEXT_PUBLIC_GA_ID=

# Vercel deployment (Stage 7)
# VERCEL_PROJECT_ID=
# VERCEL_ORG_ID=
